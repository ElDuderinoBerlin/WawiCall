<Project>
  <Import Project="$(MSBuildThisFileDirectory)Solution.props" />
  <PropertyGroup>
    <WawiCallPluginKeyFile Condition="'$(WawiCallPluginKeyFile)' == ''">$(MSBuildThisFileDirectory)..\Quantarix.Plugin.System\PluginKey.snk</WawiCallPluginKeyFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WawiCallPro.Interfaces' or '$(MSBuildProjectName)' == 'WawiCallPro.Plugin.Windows' or '$(MSBuildProjectName)' == 'WawiCallPro.Plugins.Lexware.Pro' or '$(MSBuildProjectName)' == 'WawiCallPro.Plugins.Lexware.FinOffice'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(WawiCallPluginKeyFile)</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <SharedPackage Include="Serilog" />
    <SharedProjectAssembly Include="WawiCallPro.Interfaces;Quantarix.Plugin.Abstractions;WawiCallPro.Plugin.Windows" />
    <SharedPackage Include="Dapper;Microsoft.Extensions.Configuration;Microsoft.Extensions.Configuration.Abstractions;Microsoft.Extensions.Configuration.Binder;Microsoft.Extensions.DependencyInjection;Microsoft.Extensions.DependencyInjection.Abstractions;Microsoft.Extensions.Diagnostics;Microsoft.Extensions.Diagnostics.Abstractions;Microsoft.Extensions.Logging;Microsoft.Extensions.Logging.Abstractions;Microsoft.Extensions.Options;Microsoft.Extensions.Options.ConfigurationExtensions;Microsoft.Extensions.Primitives" />
    <!-- Current shared packages each expose the matching assembly name. Packages such as DevExpress must specify RuntimeAssemblyNames explicitly. -->
  </ItemGroup>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <BaseIntermediateOutputPath>obj\$(LexwareProductLine)\</BaseIntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\$(LexwareProductLine)\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console'">
    <AssemblyName>$(MSBuildProjectName).$(LexwareProductLine)</AssemblyName>
  </PropertyGroup>
</Project>
