<Project>
  <PropertyGroup>
    <_WawiExplicitVersion Condition="'$(Version)' != ''">true</_WawiExplicitVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)Solution.props" />
  <PropertyGroup>
    <WawiCallPluginKeyFile Condition="'$(WawiCallPluginKeyFile)' == ''">$(MSBuildThisFileDirectory)..\Quantarix.Plugin.System\PluginKey.snk</WawiCallPluginKeyFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WawiCallPro.Interfaces' or '$(MSBuildProjectName)' == 'WawiCallPro.Plugin.Windows' or '$(MSBuildProjectName)' == 'WawiCallPro.Plugins.Lexware.Pro' or '$(MSBuildProjectName)' == 'WawiCallPro.Plugins.Lexware.FinOffice'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(WawiCallPluginKeyFile)</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <SharedPackage Include="Serilog" />
    <SharedPackage Include="Microsoft.Extensions.Http" Condition="'$(LexwareProductLinePro)' == 'true'" />
    <SharedProjectAssembly Include="WawiCallPro.Interfaces;Quantarix.Plugin.Abstractions;WawiCallPro.Plugin.Windows" />
    <!-- Only the selected edition is shared/preloaded from the host output. -->
    <SharedProjectAssembly Include="Quantarix.Lexware.Core;Quantarix.Lexware.APIService" Preload="true" Condition="'$(LexwareProductLinePro)' == 'true'" />
    <SharedProjectAssembly Include="Quantarix.Pcfk.Core;Quantarix.Pcfk.DataAccess;System.Data.SQLite" Preload="true" Condition="'$(LexwareProductLineFinOffice)' == 'true'" />
    <SharedPackage Include="Dapper;Microsoft.Extensions.Configuration;Microsoft.Extensions.Configuration.Abstractions;Microsoft.Extensions.Configuration.Binder;Microsoft.Extensions.DependencyInjection;Microsoft.Extensions.DependencyInjection.Abstractions;Microsoft.Extensions.Diagnostics;Microsoft.Extensions.Diagnostics.Abstractions;Microsoft.Extensions.Logging;Microsoft.Extensions.Logging.Abstractions;Microsoft.Extensions.Options;Microsoft.Extensions.Options.ConfigurationExtensions;Microsoft.Extensions.Primitives" />
    <!-- Current shared packages each expose the matching assembly name. Packages such as DevExpress must specify RuntimeAssemblyNames explicitly. -->
    <!-- The plugin's desktop reference brings the same transitive support assemblies already owned by both hosts. -->
    <SharedPackage Include="Microsoft.Extensions.ObjectPool;System.Data.OleDb;System.ServiceModel.Http" />
    <SharedPackage Include="System.ServiceModel.Primitives" RuntimeAssemblyNames="System.ServiceModel;System.ServiceModel.Duplex;System.ServiceModel.Primitives;System.ServiceModel.Security" />
  </ItemGroup>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Features>$(Features);runtime-async=on</Features>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <BaseIntermediateOutputPath>obj\$(LexwareProductLine)\</BaseIntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!-- Test runtime graphs and fixtures remain isolated, as in LxTranslate. -->
    <OutputPath Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests')) or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.TestWorker')) or $([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\Fixtures\'))">bin\$(Configuration)\$(LexwareProductLineShortName)\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WawiCallPro.App' and '$(Configuration)' == 'Debug' and '$(WawiDebugComGeneration)' != ''">
    <OutputPath>bin\ComDebug\$(LexwareProductLine)\$(WawiDebugComGeneration)\</OutputPath>
    <BaseIntermediateOutputPath>obj\ComDebug\$(LexwareProductLine)\$(WawiDebugComGeneration)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
