new file mode 100644
--- /dev/null
+++ b/Outlook/MailImportWorker.cs
@@ -0,0 +1,31 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace MMS.Office.Outlook
+{
+    internal static class MailImportWorker
+    {
+        internal static async Task<T> RunAsync<T>(Func<CancellationToken, T> read, CancellationToken token)
+        {
+            token.ThrowIfCancellationRequested();
+            var result = new TaskCompletionSource<T>(TaskCreationOptions.RunContinuationsAsynchronously);
+            var worker = new Thread(() =>
+            {
+                try
+                {
+                    token.ThrowIfCancellationRequested();
+                    var value = read(token);
+                    token.ThrowIfCancellationRequested();
+                    result.SetResult(value);
+                }
+                catch (OperationCanceledException) when (token.IsCancellationRequested) { result.SetCanceled(token); }
+                catch (Exception exception) { result.SetException(exception); }
+            }) { IsBackground = true, Name = "Outlook mail import" };
+            worker.SetApartmentState(ApartmentState.STA);
+            worker.Start();
+            try { return await result.Task.ConfigureAwait(false); }
+            finally { worker.Join(); }
+        }
+    }
+}
