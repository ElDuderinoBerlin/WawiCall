+                    or MSOutlook.OlAddressEntryUserType.olExchangeRemoteUserAddressEntry)
+                {
+                    exchangeUser = sender.GetExchangeUser();
+                    if (!string.IsNullOrWhiteSpace(exchangeUser?.PrimarySmtpAddress)) return (sender.ID, exchangeUser.PrimarySmtpAddress);
+                }
+                properties = sender.PropertyAccessor;
+                return (sender.ID, ReadSmtpProperty(properties) ?? string.Empty);
+            }
+            finally { Release(properties); Release(exchangeUser); Release(sender); }
+        }
