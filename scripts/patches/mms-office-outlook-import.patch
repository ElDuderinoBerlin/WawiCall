+        internal static List<Recipient> ReadRecipients(MSOutlook.MailItem mail)
+        {
+            var result = new List<Recipient>();
+            MSOutlook.Recipients? recipients = null;
+            try
+            {
+                recipients = mail.Recipients;
+                for (var index = 1; index <= recipients.Count; index++)
+                {
+                    MSOutlook.Recipient? recipient = null;
+                    MSOutlook.PropertyAccessor? properties = null;
+                    try
+                    {
+                        recipient = recipients[index]; properties = recipient.PropertyAccessor;
+                        var address = ReadSmtpProperty(properties);
+                        result.Add(new Recipient { Id = recipient.EntryID, Name = recipient.Name, Index = recipient.Index,
+                            Type = (MailRecipientType)recipient.Type, Address = string.IsNullOrWhiteSpace(address) ? recipient.Address : address });
+                    }
+                    finally { Release(properties); Release(recipient); }
+                }
+                return result;
+            }
+            finally { Release(recipients); }
+        }
