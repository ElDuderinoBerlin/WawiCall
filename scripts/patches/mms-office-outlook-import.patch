+        internal static (string Id, string Address) ReadSender(MSOutlook.MailItem mail)
+        {
+            MSOutlook.AddressEntry? sender = null;
+            MSOutlook.ExchangeUser? exchangeUser = null;
+            MSOutlook.PropertyAccessor? properties = null;
+            try
+            {
+                sender = mail.Sender;
