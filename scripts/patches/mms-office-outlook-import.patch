@@ -0,0 +1,115 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+
+namespace MMS.Office.Outlook
+{
+    // These adapters own the handles they return. No COM object leaves a read operation.
+    internal interface IMailImportFolder<T> : IDisposable
+    {
+        string StoreId { get; }
+        string FolderId { get; }
+        IEnumerable<IMailImportFolder<T>> GetChildren();
+        IEnumerable<IMailImportMessage<T>> GetMessages(DateTime? from, DateTime? to);
+    }
+
+    internal interface IMailImportMessage<T> : IDisposable
+    {
+        string EntryId { get; }
+        DateTime ReceivedTime { get; }
+        string? GetSenderAddress();
+        IEnumerable<string> GetRecipientAddresses();
+        T Materialize(bool includeAttachments, object? tag);
+    }
+
+    internal sealed class MailImportReader<T>
+    {
+        private readonly MailFilter[]? _filters;
+        private readonly bool _recursive;
+        private readonly DateTime? _from;
+        private readonly DateTime? _to;
+        private readonly bool _includeAttachments;
+        private readonly int? _maximum;
+        private readonly CancellationToken _token;
+        private readonly HashSet<(string Store, string Folder)> _folders = new();
+        private readonly HashSet<(string Store, string Entry)> _messages = new();
+        private readonly List<T> _result = new();
+
+        internal MailImportReader(IEnumerable<MailFilter>? filters, bool recursive, DateTime? from, DateTime? to,
+            bool includeAttachments, int? maximum, CancellationToken token)
+        {
+            from = from?.Kind == DateTimeKind.Utc ? from.Value.ToLocalTime() : from;
+            to = to?.Kind == DateTimeKind.Utc ? to.Value.ToLocalTime() : to;
+            if (from > to) throw new ArgumentException("The start must not follow the end of the import period.");
+            if (maximum is <= 0) throw new ArgumentOutOfRangeException(nameof(maximum));
+            _filters = filters?.Select(filter =>
+            {
+                ArgumentNullException.ThrowIfNull(filter);
+                ArgumentException.ThrowIfNullOrWhiteSpace(filter.Address);
+                if (!Enum.IsDefined(filter.Type)) throw new ArgumentOutOfRangeException(nameof(filters));
+                return new MailFilter(filter.Address.Trim(), filter.Type, filter.Tag);
+            }).ToArray();
+            _recursive = recursive; _from = from; _to = to;
+            _includeAttachments = includeAttachments; _maximum = maximum; _token = token;
+        }
+
+        internal IReadOnlyList<T> Result => _result;
+
+        // The caller owns the root; this reader owns all child folders and messages it obtains.
+        internal void Read(IMailImportFolder<T> root)
+        {
+            _token.ThrowIfCancellationRequested();
+            if (_filters is { Length: 0 }) return; // An explicit empty search must never become GetAll.
+            var store = root.StoreId;
+            var folderId = root.FolderId;
+            ArgumentException.ThrowIfNullOrWhiteSpace(store);
+            ArgumentException.ThrowIfNullOrWhiteSpace(folderId);
+            if (!_folders.Add((store, folderId))) return;
+            foreach (var message in root.GetMessages(_from, _to))
+            {
+                using (message)
+                {
+                    _token.ThrowIfCancellationRequested();
+                    var entry = message.EntryId;
+                    ArgumentException.ThrowIfNullOrWhiteSpace(entry);
+                    var identity = (store, entry);
+                    if (_messages.Contains(identity)) continue;
+                    if (_from.HasValue || _to.HasValue)
+                    {
+                        var received = message.ReceivedTime;
+                        if (received < _from || received > _to) continue;
+                    }
+                    if (!TryMatch(message, out var tag)) continue;
+                    _token.ThrowIfCancellationRequested();
+                    if (_maximum is { } maximum && _result.Count >= maximum)
+                        throw new InvalidOperationException("The configured mail import limit was exceeded. Narrow the folders or period.");
+                    var item = message.Materialize(_includeAttachments, tag);
+                    _token.ThrowIfCancellationRequested();
+                    _messages.Add(identity);
+                    _result.Add(item);
+                }
+            }
+            if (!_recursive) return;
+            _token.ThrowIfCancellationRequested();
+            foreach (var child in root.GetChildren())
+                using (child) Read(child);
+        }
+
+        private bool TryMatch(IMailImportMessage<T> message, out object? tag)
+        {
+            tag = null;
+            if (_filters is null) return true;
+            var sender = _filters.Any(filter => filter.Type == MailAddressType.Sender) ? message.GetSenderAddress()?.Trim() : null;
+            var senderFilter = _filters.FirstOrDefault(filter => filter.Type == MailAddressType.Sender
+                && string.Equals(filter.Address, sender, StringComparison.OrdinalIgnoreCase));
+            if (senderFilter is not null) { tag = senderFilter.Tag; return true; }
+            if (!_filters.Any(filter => filter.Type == MailAddressType.Receiver)) return false;
+            var recipients = message.GetRecipientAddresses().Select(address => address.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
+            var receiverFilter = _filters.FirstOrDefault(filter => filter.Type == MailAddressType.Receiver && recipients.Contains(filter.Address));
+            if (receiverFilter is null) return false;
+            tag = receiverFilter.Tag;
+            return true;
+        }
+    }
+}
