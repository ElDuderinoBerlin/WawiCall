diff --git a/Outlook/OutlookMailImport.cs b/Outlook/OutlookMailImport.cs
new file mode 100644
--- /dev/null
+++ b/Outlook/OutlookMailImport.cs
@@ -0,0 +1,239 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Runtime.InteropServices;
+using System.Threading;
+using MMS.Office.Mails;
+using MSOutlook = Microsoft.Office.Interop.Outlook;
+
+namespace MMS.Office.Outlook
+{
+    internal static class OutlookMailImport
+    {
+        internal static List<MailMessage> ReadDefaultFolders(MSOutlook.Application application, IEnumerable<string>? storeIds,
+            IEnumerable<DefaultFolders>? folders, MailImportReader<MailMessage> reader,
+            Func<MSOutlook.MailItem, bool, object?, MailMessage> materialize, CancellationToken token)
+        {
+            var selected = folders?.Distinct().ToArray();
+            return ReadStores(application, storeIds, reader, (store, storeId) =>
+            {
+                foreach (var folder in selected is { Length: > 0 } ? selected : new[] { DefaultFolders.FolderRoot })
+                {
+                    token.ThrowIfCancellationRequested();
+                    var raw = folder == DefaultFolders.FolderRoot ? store.GetRootFolder() : store.GetDefaultFolder((MSOutlook.OlDefaultFolders)folder);
+                    using var source = new ComFolder(raw, storeId, materialize, token);
+                    reader.Read(source);
+                }
+            }, token);
+        }
+
+        internal static List<MailMessage> ReadNamedFolders(MSOutlook.Application application, IEnumerable<string>? storeIds,
+            IEnumerable<string>? names, MailImportReader<MailMessage> reader,
+            Func<MSOutlook.MailItem, bool, object?, MailMessage> materialize, CancellationToken token)
+        {
+            var selected = names?.Where(name => !string.IsNullOrWhiteSpace(name)).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
+            return ReadStores(application, storeIds, reader, (store, storeId) =>
+            {
+                using var root = new ComFolder(store.GetRootFolder(), storeId, materialize, token);
+                if (selected is not { Length: > 0 }) { reader.Read(root); return; }
+                foreach (var path in selected)
+                {
+                    token.ThrowIfCancellationRequested();
+                    var raw = ResolveFolder(root.Folder, path, token);
+                    if (ReferenceEquals(raw, root.Folder)) reader.Read(root);
+                    else
+                    {
+                        using var source = new ComFolder(raw, storeId, materialize, token);
+                        reader.Read(source);
+                    }
+                }
+            }, token);
+        }
+
+        private static List<MailMessage> ReadStores(MSOutlook.Application application, IEnumerable<string>? storeIds,
+            MailImportReader<MailMessage> reader, Action<MSOutlook.Store, string> read, CancellationToken token)
+        {
+            ArgumentNullException.ThrowIfNull(application);
+            MSOutlook.NameSpace? session = null;
+            try
+            {
+                token.ThrowIfCancellationRequested();
+                session = application.GetNamespace("MAPI");
+                foreach (var id in storeIds ?? new[] { string.Empty })
+                {
+                    token.ThrowIfCancellationRequested();
+                    MSOutlook.Store? store = null;
+                    try
+                    {
+                        store = string.IsNullOrEmpty(id) ? session.DefaultStore : session.GetStoreFromID(id);
+                        read(store, store.StoreID);
+                    }
+                    finally { Release(store); }
+                }
+                token.ThrowIfCancellationRequested();
+                return reader.Result.ToList();
+            }
+            finally { Release(session); }
+        }
+
+        private static MSOutlook.MAPIFolder ResolveFolder(MSOutlook.MAPIFolder root, string path, CancellationToken token)
+        {
+            var parts = path.Trim('\\', '/').Split(new[] { '\\', '/' }, StringSplitOptions.RemoveEmptyEntries);
+            var current = root;
+            var owned = false;
+            try
+            {
+                var offset = parts.Length > 0 && string.Equals(parts[0], root.Name, StringComparison.OrdinalIgnoreCase) ? 1 : 0;
+                for (var index = offset; index < parts.Length; index++)
+                {
+                    token.ThrowIfCancellationRequested();
+                    MSOutlook.Folders? children = null;
+                    MSOutlook.MAPIFolder next;
+                    try { children = current.Folders; next = children[parts[index]]; }
+                    finally { Release(children); }
+                    if (owned) Release(current);
+                    current = next; owned = true;
+                }
+                return current;
+            }
+            catch { if (owned) Release(current); throw; }
+        }
+
+        private static string DateFilter(DateTime? from, DateTime? to)
+        {
+            var terms = new List<string>();
+            if (from is { } start) terms.Add("[ReceivedTime] >= '" + start.ToLocalTimeIfUtc().ToString("g", CultureInfo.CurrentCulture) + "'");
+            // Jet date filters have minute precision. Include the final minute; the reader checks the exact bound.
+            if (to is { } end) terms.Add("[ReceivedTime] <= '" + (end < DateTime.MaxValue.AddMinutes(-1) ? end.AddMinutes(1) : end).ToLocalTimeIfUtc().ToString("g", CultureInfo.CurrentCulture) + "'");
+            return string.Join(" AND ", terms);
