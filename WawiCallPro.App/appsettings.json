{
  "Help": {
    "Language": "auto",
    "ArticleCache": {
      "MaxEntries": 80,
      "MaxSizeMiB": 32
    },
    "Index": {
      "MemoryFallbackMaxMarkdownMiB": 8,
      "MemoryFallbackMaxSections": 20000
    }
  },
  "LexwareApi": {
    "ClientKey": "",
    "HideUiForScreenshots": false,
    "ArticleTransferBatchSize": 100,
    "ArticleTransferDetailBatchSize": 5,
    "TimeoutSeconds": 30,
    "TokenTimeoutSeconds": 10,
    "InstallationId": null
  },
  "AppUi": {
    "FontFamily": "Segoe UI",
    "FontSize": 9,
    "ShowStartPage": true
  },
  "PrintDialog": {
    "Theme": "Auto"
  },
  "PrintForms": {
    "PretranslateOnLanguageChange": true
  },
  "Velopack": {
    "UpdateUrl": ""
  },
  "LicenseServer": {
    "Url": "https://license.wawi-proapp.de"
  },
  "CrashReporting": {
    "Enabled": true,
    "ServiceBaseUri": "https://license.wawi-proapp.de",
    "QueueFlushIntervalSeconds": 15,
    "RequestTimeoutSeconds": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/WawiCallPro-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "settings": {},
  "Logging": {
    "Enabled": true
  }
}
