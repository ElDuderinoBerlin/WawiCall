<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>..\Application.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>false</ForceDesignerDpiUnaware>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WawiCallPro.Plugins.Dummy\WawiCallPro.Plugins.Dummy.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="../WawiCallPro.Plugin.Windows/WawiCallPro.Plugin.Windows.csproj" />
    <ProjectReference Include="..\..\Quantarix.DevExpress\Quantarix.DevExpress.csproj" />
    <ProjectReference Include="..\..\Quantarix.Interop\Quantarix.Interop.csproj" />
    <ProjectReference Include="..\WawiCallPro.Plugins.Lexware.Pro\WawiCallPro.Plugins.Lexware.Pro.csproj"
                      ReferenceOutputAssembly="false" Private="false" Condition="'$(LexwareProductLinePro)' == 'true'" />
    <ProjectReference Include="..\WawiCallPro.Plugins.Lexware.FinOffice\WawiCallPro.Plugins.Lexware.FinOffice.csproj"
                      ReferenceOutputAssembly="false" Private="false" Condition="'$(LexwareProductLineFinOffice)' == 'true'" />
    <ProjectReference Include="..\WawiCallPro.Core\WawiCallPro.Core.csproj" />
    <ProjectReference Include="..\WawiCallPro.Utilities\WawiCallPro.Utilities.csproj" />
    <ProjectReference Include="..\WawiCallPro.Database\WawiCallPro.Database.csproj" />
    <ProjectReference Include="..\WawiCallPro.Telephony.Sip\WawiCallPro.Telephony.Sip.csproj" />
    <ProjectReference Include="..\WawiCallPro.Audio\WawiCallPro.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons\*.svg" />
    <EmbeddedResource Include="AppIcon.svg;AppIcon.ico" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <InternalsVisibleTo Include="WawiCallPro.App.Tests" />
    <PackageReference Include="DevExpress.Win.Design" Version="$(DevExpressVersion)" />
  </ItemGroup>
</Project>
