<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>false</ForceDesignerDpiUnaware>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Quantarix.DevExpress\Quantarix.DevExpress.csproj" />
    <ProjectReference Include="..\..\Quantarix.Interop\Quantarix.Interop.csproj" />
    <ProjectReference Include="..\WawiCallPro.Plugins.Lexware.Pro\WawiCallPro.Plugins.Lexware.Pro.csproj"
                      ReferenceOutputAssembly="false" Condition="'$(LexwareProductLinePro)' == 'true'" />
    <ProjectReference Include="..\WawiCallPro.Plugins.Lexware.FinOffice\WawiCallPro.Plugins.Lexware.FinOffice.csproj"
                      ReferenceOutputAssembly="false" Condition="'$(LexwareProductLineFinOffice)' == 'true'" />
    <ProjectReference Include="..\WawiCallPro.Core\WawiCallPro.Core.csproj" />
    <ProjectReference Include="..\WawiCallPro.Utilities\WawiCallPro.Utilities.csproj" />
    <ProjectReference Include="..\WawiCallPro.Database\WawiCallPro.Database.csproj" />
    <ProjectReference Include="..\WawiCallPro.Telephony.Sip\WawiCallPro.Telephony.Sip.csproj" />
    <ProjectReference Include="..\WawiCallPro.Audio\WawiCallPro.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WawiCallPro.App.Tests" />
    <PackageReference Include="DevExpress.Win.Design" Version="$(DevExpressVersion)" />
  </ItemGroup>
</Project>
