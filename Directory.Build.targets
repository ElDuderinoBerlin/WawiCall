<Project>
  <!-- Same revision scheme as LxTranslate: assembly Major.Minor.0.CommitCount, display Major.Minor.CommitCount. -->
  <Target Name="WawiComputeVersion" BeforeTargets="GetAssemblyVersion"
          Condition="'$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console'">
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_WawiGitCount" />
    </Exec>
    <PropertyGroup>
      <_WawiGitCount>$(_WawiGitCount.Trim())</_WawiGitCount>
      <AssemblyVersion>$(WawiVersionMajor).$(WawiVersionMinor).0.$(_WawiGitCount)</AssemblyVersion>
      <FileVersion>$(AssemblyVersion)</FileVersion>
      <Version Condition="'$(_WawiExplicitVersion)' != 'true'">$(WawiVersionMajor).$(WawiVersionMinor).$(_WawiGitCount)</Version>
      <InformationalVersion>$(Version)</InformationalVersion>
      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)..\Quantarix.Plugin.System\Directory.Build.targets" />
  <Target Name="PrepareWawiSharedPackageAssemblies">
    <ItemGroup>
      <SharedPackage Update="@(SharedPackage)" Condition="'%(SharedPackage.RuntimeAssemblyNames)' == ''"><RuntimeAssemblyNames>%(SharedPackage.Identity)</RuntimeAssemblyNames></SharedPackage>
    </ItemGroup>
    <PropertyGroup>
      <_WawiSharedRuntimeNames>@(SharedPackage->'%(RuntimeAssemblyNames)')</_WawiSharedRuntimeNames>
      <_WawiSharedRuntimeNames>$([MSBuild]::Unescape('$(_WawiSharedRuntimeNames)'))</_WawiSharedRuntimeNames>
    </PropertyGroup>
    <ItemGroup><_WawiSharedPackageAssembly Include="$(_WawiSharedRuntimeNames)" /></ItemGroup>
  </Target>
  <Target Name="GenerateWawiSharedPackageManifest" BeforeTargets="AssignTargetPaths" DependsOnTargets="PrepareWawiSharedPackageAssemblies" Condition="'$(MSBuildProjectName)' == 'WawiCallPro.Utilities'">
    <ItemGroup>
      <_WawiPreloadedProjectAssembly Include="@(SharedProjectAssembly)" Condition="'%(SharedProjectAssembly.Preload)' == 'true'" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)WawiSharedPackages.txt" Lines="@(_WawiSharedPackageAssembly);@(_WawiPreloadedProjectAssembly)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><EmbeddedResource Include="$(IntermediateOutputPath)WawiSharedPackages.txt" LogicalName="WawiCallPro.SharedPackages" /></ItemGroup>
  </Target>
  <!-- Adapt the reference filter to MSBuild metadata matching; Identity is not custom item metadata. -->
  <Target Name="FilterSharedAssembliesAndPackages" AfterTargets="ResolveReferences" DependsOnTargets="PrepareWawiSharedPackageAssemblies" Condition="'$(IsPluginProject)' == 'true'">
    <ItemGroup>
      <_WawiSharedFiles Include="@(SharedProjectAssembly->'%(Identity).dll')" />
      <_WawiSharedPackages Include="@(SharedPackage)" />
    </ItemGroup>
    <ItemGroup>
      <_WawiSharedPackages Update="@(_WawiSharedPackages)"><NuGetPackageId>%(_WawiSharedPackages.Identity)</NuGetPackageId></_WawiSharedPackages>
    </ItemGroup>
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(_WawiSharedFiles)" MatchOnMetadata="Filename" />
      <ReferenceCopyLocalPaths Remove="@(_WawiSharedPackages)" MatchOnMetadata="NuGetPackageId" />
      <!-- Plugin UI uses the host's DevExpress instances and skin; never ship private UI copies. -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('DevExpress.'))" />
    </ItemGroup>
  </Target>
  <Target Name="GetWawiPluginDeploymentFiles" Returns="@(_WawiDeploymentFiles)" DependsOnTargets="PrepareWawiSharedPackageAssemblies" Condition="'$(IsPluginProject)' == 'true'">
    <ItemGroup><_WawiPrivateUiCopies Include="$(TargetDir)DevExpress.*.dll;$(TargetDir)DevExpress.*.pdb" /></ItemGroup>
    <Delete Files="@(_WawiPrivateUiCopies)" />
    <Delete Files="@(SharedProjectAssembly->'$(TargetDir)%(Identity).dll');@(SharedProjectAssembly->'$(TargetDir)%(Identity).pdb');@(_WawiSharedPackageAssembly->'$(TargetDir)%(Identity).dll');@(_WawiSharedPackageAssembly->'$(TargetDir)%(Identity).pdb')" />
    <ItemGroup>
      <_WawiDeploymentFiles Include="$(TargetDir)**\*">
        <PluginName>$(AssemblyName)</PluginName>
        <PluginRoot Condition="$([System.String]::Copy('$(AssemblyName)').StartsWith('WawiCallPro.Functions.'))">function-plugins</PluginRoot>
        <PluginRoot Condition="!$([System.String]::Copy('$(AssemblyName)').StartsWith('WawiCallPro.Functions.'))">plugins</PluginRoot>
      </_WawiDeploymentFiles>
    </ItemGroup>
    <ItemGroup>
      <_WawiDeploymentFiles Update="@(_WawiDeploymentFiles)">
        <PluginRelativePath>%(_WawiDeploymentFiles.RecursiveDir)%(_WawiDeploymentFiles.Filename)%(_WawiDeploymentFiles.Extension)</PluginRelativePath>
      </_WawiDeploymentFiles>
    </ItemGroup>
    <ItemGroup>
      <_WawiDeploymentFiles Remove="@(SharedProjectAssembly->'$(TargetDir)%(Identity).dll');@(SharedProjectAssembly->'$(TargetDir)%(Identity).pdb')" />
      <_WawiDeploymentFiles Remove="@(_WawiSharedPackageAssembly->'$(TargetDir)%(Identity).dll');@(_WawiSharedPackageAssembly->'$(TargetDir)%(Identity).pdb')" />
    </ItemGroup>
  </Target>
  <!-- Framework upgrades must not leave an older executable as an alternative entry point. -->
  <Target Name="WawiRemoveLegacyHostFrameworkOutputs" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetFramework)' == 'net11.0-windows10.0.19041.0'
            and ('$(MSBuildProjectName)' != 'WawiCallPro.App' or '$(WawiDebugComGeneration)' == '')
            and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <PropertyGroup>
      <_WawiLegacyWindowsOutput>$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0-windows\</_WawiLegacyWindowsOutput>
      <_WawiLegacyPortableOutput>$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0\</_WawiLegacyPortableOutput>
      <_WawiLegacyPlatformOutput>$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0-windows10.0.19041.0\</_WawiLegacyPlatformOutput>
      <_WawiLegacyNewWindowsOutput>$(MSBuildProjectDirectory)\bin\$(Configuration)\net11.0-windows\</_WawiLegacyNewWindowsOutput>
    </PropertyGroup>
    <ItemGroup>
      <_WawiLegacyHostOutput Include="$(_WawiLegacyPlatformOutput)$(MSBuildProjectName)*.exe;$(_WawiLegacyPlatformOutput)$(MSBuildProjectName)*.dll;$(_WawiLegacyPlatformOutput)$(MSBuildProjectName)*.pdb;$(_WawiLegacyPlatformOutput)$(MSBuildProjectName)*.deps.json;$(_WawiLegacyPlatformOutput)$(MSBuildProjectName)*.runtimeconfig.json" />
      <_WawiLegacyHostOutput Include="$(_WawiLegacyNewWindowsOutput)$(MSBuildProjectName)*.exe;$(_WawiLegacyNewWindowsOutput)$(MSBuildProjectName)*.dll;$(_WawiLegacyNewWindowsOutput)$(MSBuildProjectName)*.pdb;$(_WawiLegacyNewWindowsOutput)$(MSBuildProjectName)*.deps.json;$(_WawiLegacyNewWindowsOutput)$(MSBuildProjectName)*.runtimeconfig.json" />
      <_WawiLegacyHostOutput Include="$(_WawiLegacyWindowsOutput)$(MSBuildProjectName)*.exe;$(_WawiLegacyWindowsOutput)$(MSBuildProjectName)*.dll;$(_WawiLegacyWindowsOutput)$(MSBuildProjectName)*.pdb;$(_WawiLegacyWindowsOutput)$(MSBuildProjectName)*.deps.json;$(_WawiLegacyWindowsOutput)$(MSBuildProjectName)*.runtimeconfig.json" />
      <_WawiLegacyHostOutput Include="$(_WawiLegacyPortableOutput)$(MSBuildProjectName)*.exe;$(_WawiLegacyPortableOutput)$(MSBuildProjectName)*.dll;$(_WawiLegacyPortableOutput)$(MSBuildProjectName)*.pdb;$(_WawiLegacyPortableOutput)$(MSBuildProjectName)*.deps.json;$(_WawiLegacyPortableOutput)$(MSBuildProjectName)*.runtimeconfig.json" Condition="'$(MSBuildProjectName)' == 'WawiCallPro.Console'" />
    </ItemGroup>
    <Delete Files="@(_WawiLegacyHostOutput)" />
  </Target>
  <!-- The selected edition replaces the previous edition in the normal host output. -->
  <Target Name="WawiRemoveOtherEditionOutputs" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <PropertyGroup>
      <_WawiOtherEdition Condition="'$(LexwareProductLine)' == 'Pro'">FinOffice</_WawiOtherEdition>
      <_WawiOtherEdition Condition="'$(LexwareProductLine)' == 'FinOffice'">Pro</_WawiOtherEdition>
    </PropertyGroup>
    <ItemGroup>
      <_WawiStaleEditionOutput Include="$(TargetDir)plugins\WawiCallPro.Plugins.Lexware.$(_WawiOtherEdition)\**\*" />
      <_WawiStaleEditionOutput Include="$(TargetDir)$(MSBuildProjectName).$(_WawiOtherEdition).pdb;$(TargetDir)$(MSBuildProjectName).$(_WawiOtherEdition).deps.json;$(TargetDir)$(MSBuildProjectName).$(_WawiOtherEdition).runtimeconfig.json" />
    </ItemGroup>
    <!-- A running host locks its executable. Stop cleanup before deleting its startup metadata. -->
    <Delete Files="$(TargetDir)$(MSBuildProjectName).$(_WawiOtherEdition).exe" />
    <Delete Files="$(TargetDir)$(MSBuildProjectName).$(_WawiOtherEdition).dll" />
    <Delete Files="@(_WawiStaleEditionOutput)" />
  </Target>
  <Target Name="DeployWawiPlugins" AfterTargets="Build" DependsOnTargets="PrepareWawiSharedPackageAssemblies" Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <ItemGroup>
      <_WawiPluginProject Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('WawiCallPro.Plugins.')) or $([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('WawiCallPro.Functions.'))" />
    </ItemGroup>
    <MSBuild Projects="@(_WawiPluginProject)" Targets="GetWawiPluginDeploymentFiles" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishDir" Properties="Configuration=$(Configuration);LexwareProductLine=$(LexwareProductLine)">
      <Output TaskParameter="TargetOutputs" ItemName="_WawiPluginFiles" />
    </MSBuild>
    <ItemGroup>
      <_WawiDuplicatePluginFiles Include="@(SharedProjectAssembly->'$(TargetDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).dll');@(SharedProjectAssembly->'$(TargetDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).pdb');@(_WawiSharedPackageAssembly->'$(TargetDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).dll');@(_WawiSharedPackageAssembly->'$(TargetDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WawiPluginFiles)" DestinationFiles="@(_WawiPluginFiles->'$(TargetDir)%(PluginRoot)\%(PluginName)\%(PluginRelativePath)')" SkipUnchangedFiles="true" />
    <Delete Files="@(_WawiDuplicatePluginFiles)" />
  </Target>
  <Target Name="PublishWawiPlugins" AfterTargets="Publish" DependsOnTargets="DeployWawiPlugins" Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <Copy SourceFiles="@(_WawiPluginFiles)" DestinationFiles="@(_WawiPluginFiles->'$(PublishDir)%(PluginRoot)\%(PluginName)\%(PluginRelativePath)')" SkipUnchangedFiles="true" />
    <Delete Files="@(SharedProjectAssembly->'$(PublishDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).dll');@(SharedProjectAssembly->'$(PublishDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).pdb')" />
    <Delete Files="@(_WawiSharedPackageAssembly->'$(PublishDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).dll');@(_WawiSharedPackageAssembly->'$(PublishDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).pdb')" />
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="LexwareProductLine" Value="$(LexwareProductLine)" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'WawiCallPro.App'">
    <AssemblyMetadata Include="WawiLicenseRequired" Value="$(WawiLicenseRequired)" />
    <AssemblyMetadata Include="WawiLicenseActivationMode" Value="$(LicenseActivationMode)" />
  </ItemGroup>
  <Target Name="ValidateLexwareProductLine" BeforeTargets="_GenerateRestoreGraphProjectEntry;PrepareForBuild">
    <Error Condition="'$(LexwareProductLine)' != 'Pro' and '$(LexwareProductLine)' != 'FinOffice'"
           Text="Ungültige LexwareProductLine '$(LexwareProductLine)'. Erlaubt sind Pro und FinOffice." />
  </Target>
  <Target Name="ValidateWawiCallReferences" BeforeTargets="ResolveReferences">
    <Error Condition="$([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('MMS.'))"
           Text="MMS-Projektreferenz ist nicht erlaubt: %(ProjectReference.Identity). Eine konkrete Quantarix-API verwenden." />
    <Error Condition="$([System.String]::Copy('%(Reference.Identity)').StartsWith('MMS.'))"
           Text="MMS-Assemblyreferenz ist nicht erlaubt: %(Reference.Identity). Eine konkrete Quantarix-API verwenden." />
  </Target>
  <PropertyGroup>
    <WawiStripDxLicenseInformationEnabled Condition="'$(WawiStripDxLicenseInformationEnabled)' == ''">true</WawiStripDxLicenseInformationEnabled>
    <_WawiStripDxHost Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'
        and '$(WawiStripDxLicenseInformationEnabled)' == 'true'
        and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">true</_WawiStripDxHost>
  </PropertyGroup>
  <!-- Build dependency only: Mono.Cecil and the tool must never become host runtime dependencies. -->
  <ItemGroup Condition="'$(_WawiStripDxHost)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Tools\StripDxLicenseInformation\StripDxLicenseInformation.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="_WawiStripDxTool"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;PublishAot;OutDir;OutputPath;BaseOutputPath;BaseIntermediateOutputPath;IntermediateOutputPath" />
  </ItemGroup>
  <Target Name="WawiValidateStripDxTool" Condition="'$(_WawiStripDxHost)' == 'true'"
          DependsOnTargets="ResolveProjectReferences">
    <Error Condition="'@(_WawiStripDxTool->Count())' != '1' or !Exists('@(_WawiStripDxTool)')"
           Text="StripDxLicenseInformation fehlt. Tool und Host mit derselben Konfiguration/Produktlinie bauen." />
    <PropertyGroup>
      <_WawiStripDxToolPath>@(_WawiStripDxTool->'%(FullPath)')</_WawiStripDxToolPath>
      <_WawiStripDxKeyArgument Condition="'$(WawiStripDxLicenseInformationKeyFile)' != ''">--key-file &quot;$(WawiStripDxLicenseInformationKeyFile)&quot;</_WawiStripDxKeyArgument>
    </PropertyGroup>
  </Target>
  <Target Name="WawiStripDxLicenseInformationFromBuildOutput" AfterTargets="Build"
          DependsOnTargets="WawiValidateStripDxTool" Condition="'$(_WawiStripDxHost)' == 'true'">
    <Exec Command="dotnet &quot;$(_WawiStripDxToolPath)&quot; --input &quot;$(TargetDir).&quot; --pattern &quot;WawiCallPro*.dll&quot; --pattern &quot;WawiCallPro*.exe&quot; $(_WawiStripDxKeyArgument)"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>
  <Target Name="WawiStripDxLicenseInformationFromPublishOutput" AfterTargets="Publish"
          DependsOnTargets="WawiValidateStripDxTool" Condition="'$(_WawiStripDxHost)' == 'true'">
    <PropertyGroup>
      <_WawiStripDxPublishDir Condition="$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$(PublishDir)</_WawiStripDxPublishDir>
      <_WawiStripDxPublishDir Condition="'$(_WawiStripDxPublishDir)' == ''">$(MSBuildProjectDirectory)\$(PublishDir)</_WawiStripDxPublishDir>
      <_WawiStripDxPublishDir>$([MSBuild]::EnsureTrailingSlash('$(_WawiStripDxPublishDir)'))</_WawiStripDxPublishDir>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(_WawiStripDxToolPath)&quot; --input &quot;$(_WawiStripDxPublishDir).&quot; --pattern &quot;WawiCallPro*.dll&quot; --pattern &quot;WawiCallPro*.exe&quot; $(_WawiStripDxKeyArgument)"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>
  <Target Name="RemoveWawiOtherLexwareAssemblies" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <ItemGroup>
      <_WawiOutputLibraries Include="$(TargetDir)**\*.dll;$(TargetDir)**\*.pdb;$(TargetDir)**\*.xml" />
      <_WawiOtherLexwareFiles Include="@(_WawiOutputLibraries)" Condition="$([System.String]::Copy(';$(WawiExcludedLexwareAssemblyNames);').Contains(';%(_WawiOutputLibraries.Filename);'))" />
    </ItemGroup>
    <Delete Files="@(_WawiOtherLexwareFiles)" />
  </Target>
  <Target Name="RemoveWawiOtherLexwarePublishAssemblies" AfterTargets="Publish" DependsOnTargets="RemoveWawiOtherLexwareAssemblies" Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <PropertyGroup>
      <_WawiOtherPublishEdition Condition="'$(LexwareProductLinePro)' == 'true'">FinOffice</_WawiOtherPublishEdition>
      <_WawiOtherPublishEdition Condition="'$(LexwareProductLineFinOffice)' == 'true'">Pro</_WawiOtherPublishEdition>
    </PropertyGroup>
    <ItemGroup>
      <_WawiStaleEditionPublish Include="$(PublishDir)plugins\WawiCallPro.Plugins.Lexware.$(_WawiOtherPublishEdition)\**\*" />
      <_WawiStaleEditionPublish Include="$(PublishDir)$(MSBuildProjectName).$(_WawiOtherPublishEdition).dll;$(PublishDir)$(MSBuildProjectName).$(_WawiOtherPublishEdition).exe;$(PublishDir)$(MSBuildProjectName).$(_WawiOtherPublishEdition).pdb;$(PublishDir)$(MSBuildProjectName).$(_WawiOtherPublishEdition).deps.json;$(PublishDir)$(MSBuildProjectName).$(_WawiOtherPublishEdition).runtimeconfig.json" />
      <_WawiPublishLibraries Include="$(PublishDir)**\*.dll;$(PublishDir)**\*.pdb;$(PublishDir)**\*.xml" />
      <_WawiOtherLexwarePublishFiles Include="@(_WawiPublishLibraries)" Condition="$([System.String]::Copy(';$(WawiExcludedLexwareAssemblyNames);').Contains(';%(_WawiPublishLibraries.Filename);'))" />
    </ItemGroup>
    <Delete Files="@(_WawiOtherLexwarePublishFiles);@(_WawiStaleEditionPublish)" />
  </Target>
  <!-- Use the supplied SQLite build in every native search location. Keep e_sqlite3 independent. -->
  <PropertyGroup>
    <_WawiSqliteInteropHost Condition="'$(LexwareProductLineFinOffice)' == 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console' or '$(MSBuildProjectName)' == 'WawiCallPro.Plugins.Lexware.FinOffice' or '$(MSBuildProjectName)' == 'WawiCallPro.Plugins.Lexware.FinOffice.Tests')">true</_WawiSqliteInteropHost>
    <WawiSqliteInteropRoot Condition="'$(WawiSqliteInteropRoot)' == ''">$(MSBuildThisFileDirectory)..\sqlite-netFx-source-1.0.117.0\bin</WawiSqliteInteropRoot>
  </PropertyGroup>
  <Target Name="PrepareWawiSqliteInterop" BeforeTargets="PrepareForBuild"
          Condition="'$(_WawiSqliteInteropHost)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_WawiSqliteArchitecture Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</_WawiSqliteArchitecture>
      <_WawiSqliteArchitecture Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</_WawiSqliteArchitecture>
      <_WawiSqliteArchitecture Condition="'$(RuntimeIdentifier)' == '' and ('$(PlatformTarget)' == 'x86' or '$(Platform)' == 'x86')">x86</_WawiSqliteArchitecture>
      <_WawiSqliteArchitecture Condition="'$(RuntimeIdentifier)' == '' and '$(_WawiSqliteArchitecture)' == '' and ('$(PlatformTarget)' == 'x64' or '$(Platform)' == 'x64')">x64</_WawiSqliteArchitecture>
      <_WawiSqliteX86Path>$(WawiSqliteInteropRoot)\Win32\$(Configuration)\SQLite.Interop.dll</_WawiSqliteX86Path>
      <_WawiSqliteX64Path>$(WawiSqliteInteropRoot)\x64\$(Configuration)\SQLite.Interop.dll</_WawiSqliteX64Path>
    </PropertyGroup>
    <Error Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x86' and '$(RuntimeIdentifier)' != 'win-x64'"
           Text="Die eigene SQLite.Interop unterstützt hier nur win-x86 und win-x64, nicht $(RuntimeIdentifier)." />
    <ItemGroup>
      <_WawiSqliteInterop Remove="@(_WawiSqliteInterop)" />
      <_WawiSqliteInterop Include="$(_WawiSqliteX86Path)" Condition="'$(_WawiSqliteArchitecture)' == '' or '$(_WawiSqliteArchitecture)' == 'x86'">
        <RelativePath>runtimes\win-x86\native\SQLite.Interop.dll</RelativePath>
      </_WawiSqliteInterop>
      <_WawiSqliteInterop Include="$(_WawiSqliteX64Path)" Condition="'$(_WawiSqliteArchitecture)' == '' or '$(_WawiSqliteArchitecture)' == 'x64'">
        <RelativePath>runtimes\win-x64\native\SQLite.Interop.dll</RelativePath>
      </_WawiSqliteInterop>
      <!-- The current provider's .NET detection misses .NET 11. Its legacy preload paths remain reliable. -->
      <_WawiSqliteInterop Include="$(_WawiSqliteX86Path)" Condition="'$(_WawiSqliteArchitecture)' == '' or '$(_WawiSqliteArchitecture)' == 'x86'">
        <RelativePath>x86\SQLite.Interop.dll</RelativePath>
      </_WawiSqliteInterop>
      <_WawiSqliteInterop Include="$(_WawiSqliteX64Path)" Condition="'$(_WawiSqliteArchitecture)' == '' or '$(_WawiSqliteArchitecture)' == 'x64'">
        <RelativePath>x64\SQLite.Interop.dll</RelativePath>
      </_WawiSqliteInterop>
    </ItemGroup>
    <Error Condition="!Exists('%(_WawiSqliteInterop.Identity)')"
           Text="Eigene SQLite.Interop fehlt: %(_WawiSqliteInterop.Identity). SQLite.Interop im Schwesterrepository für die passende Architektur und $(Configuration) bauen." />
  </Target>
  <!-- Copy last, even when a stale NuGet/output file has a newer timestamp. -->
  <Target Name="CopyWawiSqliteInterop" AfterTargets="Build" DependsOnTargets="PrepareWawiSqliteInterop"
          Condition="'$(_WawiSqliteInteropHost)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_WawiSqliteInterop)" DestinationFiles="@(_WawiSqliteInterop->'$(TargetDir)%(RelativePath)')" />
    <Delete Files="$(TargetDir)SQLite.Interop.dll" />
    <ItemGroup><FileWrites Include="@(_WawiSqliteInterop->'$(TargetDir)%(RelativePath)')" /></ItemGroup>
  </Target>
  <Target Name="PublishWawiSqliteInterop" AfterTargets="Publish" DependsOnTargets="PrepareWawiSqliteInterop"
          Condition="'$(_WawiSqliteInteropHost)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_WawiSqliteInterop)" DestinationFiles="@(_WawiSqliteInterop->'$(PublishDir)%(RelativePath)')" />
    <Delete Files="$(PublishDir)SQLite.Interop.dll" />
    <ItemGroup><FileWrites Include="@(_WawiSqliteInterop->'$(PublishDir)%(RelativePath)')" /></ItemGroup>
  </Target>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'WawiCallPro.Console'">
    <Content Include="$(MSBuildThisFileDirectory)WawiCallPro.App\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="InitializeWawiAppSettings" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <PropertyGroup>
      <_WawiSeedClientKey>0</_WawiSeedClientKey>
      <_WawiNeutralLexwareApi>0</_WawiNeutralLexwareApi>
      <_WawiNeutralLexwareApi Condition="'$(WawiUseVelopackAppSettings)' == 'true'">1</_WawiNeutralLexwareApi>
      <_WawiSeedClientKey Condition="'$(Configuration)' == 'Debug' and '$(WawiIncludeBuildLexwareClientKeyDefault)' == 'true' and '$(WawiUseVelopackAppSettings)' != 'true'">1</_WawiSeedClientKey>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)scripts\initialize-appsettings.ps1&quot; -SettingsPath &quot;$(TargetDir)appsettings.json&quot; -SolutionProps &quot;$(MSBuildThisFileDirectory)Solution.props&quot; -ProductLine $(LexwareProductLine) -Configuration $(Configuration) -DebugDefaults &quot;$(MSBuildThisFileDirectory).artifacts\developer-lexware-defaults.json&quot; -IncludeClientKey $(_WawiSeedClientKey) -NeutralLexwareApi $(_WawiNeutralLexwareApi)" EchoOff="true" />
  </Target>
  <Target Name="InitializeWawiPublishedAppSettings" AfterTargets="Publish" DependsOnTargets="InitializeWawiAppSettings" Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <Copy SourceFiles="$(TargetDir)appsettings.json" DestinationFiles="$(PublishDir)appsettings.json" />
  </Target>
  <Target Name="RefreshWawiDebugCom" AfterTargets="Build"
          DependsOnTargets="DeployWawiPlugins;RemoveWawiOtherLexwareAssemblies;CopyWawiSqliteInterop;InitializeWawiAppSettings"
          Condition="'$(MSBuildProjectName)' == 'WawiCallPro.App' and '$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'
            and '$(WawiDebugComGeneration)' == '' and '$(OS)' == 'Windows_NT' and '$(DemoBuild)' != 'true'
            and '$(WawiUseVelopackAppSettings)' != 'true' and '$(WawiRegisterDebugCom)' != 'false'">
    <ItemGroup>
      <_WawiDebugComFiles Include="@(FileWrites);@(_WawiPluginFiles->'$(TargetDir)%(PluginRoot)\%(PluginName)\%(PluginRelativePath)');$(TargetDir)appsettings.json" />
      <_WawiDebugComExcludedFiles Include="@(_WawiDuplicatePluginFiles);@(_WawiOtherLexwareFiles);$(TargetDir)SQLite.Interop.dll" />
      <_WawiDebugComFiles Remove="@(_WawiDebugComExcludedFiles)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <FindUnderPath Path="$(TargetDir)" Files="@(_WawiDebugComFiles)" UpdateToAbsolutePaths="true">
      <Output TaskParameter="InPath" ItemName="_WawiDebugComOutputFiles" />
    </FindUnderPath>
    <WriteLinesToFile File="$(IntermediateOutputPath)WawiDebugComFiles.txt" Lines="@(_WawiDebugComOutputFiles)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)scripts\register-debug-com.ps1&quot; -ProductLine $(LexwareProductLine) -CompletedBuildDirectory &quot;$(TargetDir).&quot; -BuildFileList &quot;$(IntermediateOutputPath)WawiDebugComFiles.txt&quot;" />
  </Target>
</Project>
