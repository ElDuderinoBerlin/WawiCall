<Project>
  <!-- Same revision scheme as LxTranslate: assembly Major.Minor.0.CommitCount, display Major.Minor.CommitCount. -->
  <Target Name="WawiComputeVersion" BeforeTargets="GetAssemblyVersion"
          Condition="'$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console'">
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_WawiGitCount" />
    </Exec>
    <PropertyGroup>
      <_WawiGitCount>$(_WawiGitCount.Trim())</_WawiGitCount>
      <AssemblyVersion>$(WawiVersionMajor).$(WawiVersionMinor).0.$(_WawiGitCount)</AssemblyVersion>
      <FileVersion>$(AssemblyVersion)</FileVersion>
      <Version Condition="'$(_WawiExplicitVersion)' != 'true'">$(WawiVersionMajor).$(WawiVersionMinor).$(_WawiGitCount)</Version>
      <InformationalVersion>$(Version)</InformationalVersion>
      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)..\Quantarix.Plugin.System\Directory.Build.targets" />
  <Target Name="GenerateWawiSharedPackageManifest" BeforeTargets="AssignTargetPaths" Condition="'$(MSBuildProjectName)' == 'WawiCallPro.Utilities'">
    <ItemGroup><SharedPackage Update="@(SharedPackage)" Condition="'%(SharedPackage.RuntimeAssemblyNames)' == ''"><RuntimeAssemblyNames>%(SharedPackage.Identity)</RuntimeAssemblyNames></SharedPackage></ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)WawiSharedPackages.txt" Lines="@(SharedPackage->'%(RuntimeAssemblyNames)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><EmbeddedResource Include="$(IntermediateOutputPath)WawiSharedPackages.txt" LogicalName="WawiCallPro.SharedPackages" /></ItemGroup>
  </Target>
  <!-- Adapt the reference filter to MSBuild metadata matching; Identity is not custom item metadata. -->
  <Target Name="FilterSharedAssembliesAndPackages" AfterTargets="ResolveReferences" Condition="'$(IsPluginProject)' == 'true'">
    <ItemGroup>
      <_WawiSharedFiles Include="@(SharedProjectAssembly->'%(Identity).dll')" />
      <_WawiSharedPackages Include="@(SharedPackage)" />
    </ItemGroup>
    <ItemGroup>
      <_WawiSharedPackages Update="@(_WawiSharedPackages)"><NuGetPackageId>%(_WawiSharedPackages.Identity)</NuGetPackageId></_WawiSharedPackages>
    </ItemGroup>
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(_WawiSharedFiles)" MatchOnMetadata="Filename" />
      <ReferenceCopyLocalPaths Remove="@(_WawiSharedPackages)" MatchOnMetadata="NuGetPackageId" />
    </ItemGroup>
  </Target>
  <Target Name="GetWawiPluginDeploymentFiles" Returns="@(_WawiDeploymentFiles)" Condition="'$(IsPluginProject)' == 'true'">
    <Delete Files="@(SharedProjectAssembly->'$(TargetDir)%(Identity).dll');@(SharedProjectAssembly->'$(TargetDir)%(Identity).pdb');@(SharedPackage->'$(TargetDir)%(Identity).dll');@(SharedPackage->'$(TargetDir)%(Identity).pdb')" />
    <ItemGroup>
      <_WawiDeploymentFiles Include="$(TargetDir)**\*">
        <PluginName>$(AssemblyName)</PluginName>
      </_WawiDeploymentFiles>
    </ItemGroup>
    <ItemGroup>
      <_WawiDeploymentFiles Update="@(_WawiDeploymentFiles)">
        <PluginRelativePath>%(_WawiDeploymentFiles.RecursiveDir)%(_WawiDeploymentFiles.Filename)%(_WawiDeploymentFiles.Extension)</PluginRelativePath>
      </_WawiDeploymentFiles>
    </ItemGroup>
    <ItemGroup>
      <_WawiDeploymentFiles Remove="@(SharedProjectAssembly->'$(TargetDir)%(Identity).dll');@(SharedProjectAssembly->'$(TargetDir)%(Identity).pdb')" />
      <_WawiDeploymentFiles Remove="@(SharedPackage->'$(TargetDir)%(Identity).dll');@(SharedPackage->'$(TargetDir)%(Identity).pdb')" />
    </ItemGroup>
  </Target>
  <!-- The Windows media endpoint changed the hosts' TFM. Do not leave an older executable as an alternative entry point. -->
  <Target Name="WawiRemoveLegacyHostFrameworkOutputs" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'
            and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <PropertyGroup>
      <_WawiLegacyWindowsOutput>$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0-windows\</_WawiLegacyWindowsOutput>
      <_WawiLegacyPortableOutput>$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0\</_WawiLegacyPortableOutput>
    </PropertyGroup>
    <ItemGroup>
      <_WawiLegacyHostOutput Include="$(_WawiLegacyWindowsOutput)$(MSBuildProjectName)*.exe;$(_WawiLegacyWindowsOutput)$(MSBuildProjectName)*.dll;$(_WawiLegacyWindowsOutput)$(MSBuildProjectName)*.pdb;$(_WawiLegacyWindowsOutput)$(MSBuildProjectName)*.deps.json;$(_WawiLegacyWindowsOutput)$(MSBuildProjectName)*.runtimeconfig.json" />
      <_WawiLegacyHostOutput Include="$(_WawiLegacyPortableOutput)$(MSBuildProjectName)*.exe;$(_WawiLegacyPortableOutput)$(MSBuildProjectName)*.dll;$(_WawiLegacyPortableOutput)$(MSBuildProjectName)*.pdb;$(_WawiLegacyPortableOutput)$(MSBuildProjectName)*.deps.json;$(_WawiLegacyPortableOutput)$(MSBuildProjectName)*.runtimeconfig.json" Condition="'$(MSBuildProjectName)' == 'WawiCallPro.Console'" />
    </ItemGroup>
    <Delete Files="@(_WawiLegacyHostOutput)" />
  </Target>
  <!-- The selected edition replaces the previous edition in the normal host output. -->
  <Target Name="WawiRemoveOtherEditionOutputs" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <PropertyGroup>
      <_WawiOtherEdition Condition="'$(LexwareProductLine)' == 'Pro'">FinOffice</_WawiOtherEdition>
      <_WawiOtherEdition Condition="'$(LexwareProductLine)' == 'FinOffice'">Pro</_WawiOtherEdition>
    </PropertyGroup>
    <ItemGroup>
      <_WawiStaleEditionOutput Include="$(TargetDir)plugins\WawiCallPro.Plugins.Lexware.$(_WawiOtherEdition)\**\*" />
      <_WawiStaleEditionOutput Include="$(TargetDir)$(MSBuildProjectName).$(_WawiOtherEdition).dll;$(TargetDir)$(MSBuildProjectName).$(_WawiOtherEdition).exe;$(TargetDir)$(MSBuildProjectName).$(_WawiOtherEdition).pdb;$(TargetDir)$(MSBuildProjectName).$(_WawiOtherEdition).deps.json;$(TargetDir)$(MSBuildProjectName).$(_WawiOtherEdition).runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(_WawiStaleEditionOutput)" />
  </Target>
  <Target Name="DeployWawiPlugins" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <ItemGroup>
      <_WawiPluginProject Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('WawiCallPro.Plugins.'))" />
    </ItemGroup>
    <MSBuild Projects="@(_WawiPluginProject)" Targets="GetWawiPluginDeploymentFiles" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishDir" Properties="Configuration=$(Configuration);LexwareProductLine=$(LexwareProductLine)">
      <Output TaskParameter="TargetOutputs" ItemName="_WawiPluginFiles" />
    </MSBuild>
    <Copy SourceFiles="@(_WawiPluginFiles)" DestinationFiles="@(_WawiPluginFiles->'$(TargetDir)plugins\%(PluginName)\%(PluginRelativePath)')" SkipUnchangedFiles="true" />
    <Delete Files="@(SharedProjectAssembly->'$(TargetDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).dll');@(SharedProjectAssembly->'$(TargetDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).pdb')" />
    <Delete Files="@(SharedPackage->'$(TargetDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).dll');@(SharedPackage->'$(TargetDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).pdb')" />
  </Target>
  <Target Name="PublishWawiPlugins" AfterTargets="Publish" DependsOnTargets="DeployWawiPlugins" Condition="'$(DesignTimeBuild)' != 'true' and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">
    <Copy SourceFiles="@(_WawiPluginFiles)" DestinationFiles="@(_WawiPluginFiles->'$(PublishDir)plugins\%(PluginName)\%(PluginRelativePath)')" SkipUnchangedFiles="true" />
    <Delete Files="@(SharedProjectAssembly->'$(PublishDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).dll');@(SharedProjectAssembly->'$(PublishDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).pdb')" />
    <Delete Files="@(SharedPackage->'$(PublishDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).dll');@(SharedPackage->'$(PublishDir)plugins\WawiCallPro.Plugins.Lexware.$(LexwareProductLine)\%(Identity).pdb')" />
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="LexwareProductLine" Value="$(LexwareProductLine)" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'WawiCallPro.App'">
    <AssemblyMetadata Include="WawiLicenseRequired" Value="$(WawiLicenseRequired)" />
  </ItemGroup>
  <Target Name="ValidateLexwareProductLine" BeforeTargets="_GenerateRestoreGraphProjectEntry;PrepareForBuild">
    <Error Condition="'$(LexwareProductLine)' != 'Pro' and '$(LexwareProductLine)' != 'FinOffice'"
           Text="Ungültige LexwareProductLine '$(LexwareProductLine)'. Erlaubt sind Pro und FinOffice." />
  </Target>
  <Target Name="ValidateWawiCallReferences" BeforeTargets="ResolveReferences">
    <Error Condition="$([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('MMS.'))"
           Text="MMS-Projektreferenz ist nicht erlaubt: %(ProjectReference.Identity). Eine konkrete Quantarix-API verwenden." />
    <Error Condition="$([System.String]::Copy('%(Reference.Identity)').StartsWith('MMS.'))"
           Text="MMS-Assemblyreferenz ist nicht erlaubt: %(Reference.Identity). Eine konkrete Quantarix-API verwenden." />
  </Target>
  <PropertyGroup>
    <WawiStripDxLicenseInformationEnabled Condition="'$(WawiStripDxLicenseInformationEnabled)' == ''">true</WawiStripDxLicenseInformationEnabled>
    <_WawiStripDxHost Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'
        and '$(WawiStripDxLicenseInformationEnabled)' == 'true'
        and ('$(MSBuildProjectName)' == 'WawiCallPro.App' or '$(MSBuildProjectName)' == 'WawiCallPro.Console')">true</_WawiStripDxHost>
  </PropertyGroup>
  <!-- Build dependency only: Mono.Cecil and the tool must never become host runtime dependencies. -->
  <ItemGroup Condition="'$(_WawiStripDxHost)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Tools\StripDxLicenseInformation\StripDxLicenseInformation.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="_WawiStripDxTool"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;PublishAot;OutDir;OutputPath;BaseOutputPath;BaseIntermediateOutputPath;IntermediateOutputPath" />
  </ItemGroup>
  <Target Name="WawiValidateStripDxTool" Condition="'$(_WawiStripDxHost)' == 'true'"
          DependsOnTargets="ResolveProjectReferences">
    <Error Condition="'@(_WawiStripDxTool->Count())' != '1' or !Exists('@(_WawiStripDxTool)')"
           Text="StripDxLicenseInformation fehlt. Tool und Host mit derselben Konfiguration/Produktlinie bauen." />
    <PropertyGroup>
      <_WawiStripDxToolPath>@(_WawiStripDxTool->'%(FullPath)')</_WawiStripDxToolPath>
      <_WawiStripDxKeyArgument Condition="'$(WawiStripDxLicenseInformationKeyFile)' != ''">--key-file &quot;$(WawiStripDxLicenseInformationKeyFile)&quot;</_WawiStripDxKeyArgument>
    </PropertyGroup>
  </Target>
  <Target Name="WawiStripDxLicenseInformationFromBuildOutput" AfterTargets="Build"
          DependsOnTargets="WawiValidateStripDxTool" Condition="'$(_WawiStripDxHost)' == 'true'">
    <Exec Command="dotnet &quot;$(_WawiStripDxToolPath)&quot; --input &quot;$(TargetDir).&quot; --pattern &quot;WawiCallPro*.dll&quot; --pattern &quot;WawiCallPro*.exe&quot; $(_WawiStripDxKeyArgument)"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>
  <Target Name="WawiStripDxLicenseInformationFromPublishOutput" AfterTargets="Publish"
          DependsOnTargets="WawiValidateStripDxTool" Condition="'$(_WawiStripDxHost)' == 'true'">
    <PropertyGroup>
      <_WawiStripDxPublishDir Condition="$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$(PublishDir)</_WawiStripDxPublishDir>
      <_WawiStripDxPublishDir Condition="'$(_WawiStripDxPublishDir)' == ''">$(MSBuildProjectDirectory)\$(PublishDir)</_WawiStripDxPublishDir>
      <_WawiStripDxPublishDir>$([MSBuild]::EnsureTrailingSlash('$(_WawiStripDxPublishDir)'))</_WawiStripDxPublishDir>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(_WawiStripDxToolPath)&quot; --input &quot;$(_WawiStripDxPublishDir).&quot; --pattern &quot;WawiCallPro*.dll&quot; --pattern &quot;WawiCallPro*.exe&quot; $(_WawiStripDxKeyArgument)"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>
</Project>
