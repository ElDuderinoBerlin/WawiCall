<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WawiLicensePublicKeysFile Condition="'$(WawiLicensePublicKeysFile)' == ''">$(MSBuildThisFileDirectory)Licensing\license-public-keys.json</WawiLicensePublicKeysFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(LexwareProductLine)' == 'Pro' and '$(WawiIncludeBuildLexwareClientKeyDefault)' == 'true' and '$(WawiUseVelopackAppSettings)' != 'true' and '$(LexwareApiDefaultClientKey)' != ''">
    <AssemblyMetadata Include="WawiCallPro.LexwareApiClientKey" Value="$(LexwareApiDefaultClientKey)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(WawiLicensePublicKeysFile)" LogicalName="WawiCallPro.LicensePublicKeys" />
    <ProjectReference Include="..\..\Quantarix.License.System\Quantarix.License.Client\Quantarix.License.Client.csproj" />
    <ProjectReference Include="..\..\Quantarix.Core\Quantarix.Core.csproj" />
    <ProjectReference Include="..\..\Quantarix.Plugin.System\src\Quantarix.Plugin.Hosting\Quantarix.Plugin.Hosting.csproj" />
    <ProjectReference Include="..\WawiCallPro.Interfaces\WawiCallPro.Interfaces.csproj" />
    <ProjectReference Include="..\WawiCallPro.Core\WawiCallPro.Core.csproj" />
    <ProjectReference Include="..\WawiCallPro.Database\WawiCallPro.Database.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>
</Project>
