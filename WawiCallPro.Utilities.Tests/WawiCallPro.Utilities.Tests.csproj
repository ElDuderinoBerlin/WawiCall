<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <TestingExtensionsProfile>None</TestingExtensionsProfile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Headless runtime tests load the actual Windows plugin; they do not implement WinForms UI. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <ProjectReference Include="..\WawiCallPro.Plugins.Dummy\WawiCallPro.Plugins.Dummy.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Compile Remove="Fixtures/**/*.cs" />
    <!-- Mixed-edition fixture tests deliberately reference both; production hosts do not. -->
    <ProjectReference Include="..\..\Quantarix.Lexware.Core\Quantarix.Lexware.Core.csproj" />
    <ProjectReference Include="..\..\Quantarix.Pcfk.Core\Quantarix.Pcfk.Core.csproj" />
    <ProjectReference Include="Fixtures/RuntimePlugin/RuntimePlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures/SignedRuntimePlugin/SignedRuntimePlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WawiCallPro.Utilities\WawiCallPro.Utilities.csproj" />
    <ProjectReference Include="..\WawiCallPro.Plugin.Windows\WawiCallPro.Plugin.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Update="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>
</Project>
